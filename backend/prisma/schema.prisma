generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  travelStyle  String?
  homeCurrency String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips         Trip[]              @relation("owner")
  collaborates  TripCollaborator[]
  comments      Comment[]
  notifications Notification[]
  sessions      Session[]
  subscription  Subscription?
  conversations Conversation[]
  messages      Message[]
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
}

model Trip {
  id              String   @id @default(uuid())
  ownerId         String
  owner           User     @relation("owner", fields: [ownerId], references: [id])
  name            String
  subtitle        String?
  coverPhotoUrl   String?
  originCode      String?
  destinationCode String?
  startDate       DateTime
  endDate         DateTime
  budgetPlanned   Decimal  @default(0)
  status          String   @default("draft")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  stops         Stop[]
  collaborators TripCollaborator[]
}

model TripCollaborator {
  tripId String
  userId String
  role   String
  trip   Trip   @relation(fields: [tripId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([tripId, userId])
}

model Stop {
  id         String   @id @default(uuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id])
  dayIndex   Int
  orderIndex Int
  name       String
  category   String   @default("see")
  city       String?
  country    String?
  booked     Boolean  @default(false)
  lat        Float?
  lng        Float?
  startTime  DateTime?
  endTime    DateTime?
  cost       Decimal  @default(0)
  currency   String   @default("USD")
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  comments Comment[]
}

model Comment {
  id        String   @id @default(uuid())
  stopId    String
  stop      Stop     @relation(fields: [stopId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model RecommendationCache {
  id          String   @id @default(uuid())
  contextHash String   @unique
  payloadJson Json
  expiresAt   DateTime
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  type        String
  payloadJson Json
  readAt      DateTime?
  createdAt   DateTime  @default(now())
}

// A traveler's message thread with a listing's host. There's no separate
// Host/Listing table yet — listing catalog data lives in the frontend's
// static fixtures — so the host/listing identity is captured here as plain
// fields at creation time. `listingId` is the frontend's listing id string,
// used to find-or-create the same thread instead of duplicating it.
model Conversation {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId      String
  listingTitle   String
  listingImageUrl String?
  hostName       String
  hostAvatarUrl  String?
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages Message[]
  calls    CallLog[]

  @@unique([userId, listingId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Null when senderRole is "host" — hosts aren't real User rows yet.
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id])
  senderRole     String
  // "text" | "voice" | "image" | "file" | "call" — see message.dto.ts.
  // Kept as a plain string (not an enum) so new types don't need a migration.
  type           String       @default("text")
  body           String
  // Data URL for voice/image/file payloads (Stage 1 has no object storage —
  // see main.ts body-size limit bump for why this is viable short-term).
  mediaUrl       String?
  mediaMimeType  String?
  mediaDurationSec Int?
  fileName       String?
  fileSizeBytes  Int?
  // Set only when type === "call"; mirrors the terminal CallLog row so the
  // chat bubble doesn't need a join to render "Voice call · 2:14".
  callStatus     String?
  callDurationSec Int?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
}

// A simulated voice call against a listing's host, mirroring how host chat
// replies are simulated: no real telephony/WebRTC peer, but a real,
// persisted, server-timed call lifecycle so the UI never fakes state the
// backend doesn't also believe. See calls.service.ts.
model CallLog {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // "ringing" -> "active" -> "ended" | "no_answer"
  status         String       @default("ringing")
  startedAt      DateTime     @default(now())
  connectedAt    DateTime?
  endedAt        DateTime?
  durationSec    Int?
  // The Message row created once the call reaches a terminal state, so the
  // thread shows a "Voice call" bubble. Null while the call is in flight.
  messageId      String?      @unique
  createdAt      DateTime     @default(now())
}

model Subscription {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String   @default("explorer")
  billingCycle       String   @default("monthly")
  status             String   @default("active")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  canceledAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
