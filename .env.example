# --- Core ---
NODE_ENV=development
PORT=4000

# --- Database (Stage 1: single Postgres; Stage 2: one per service) ---
DATABASE_URL=postgresql://globetrotter:globetrotter@localhost:5432/globetrotter

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=

# --- AI / Recommendations ---
# Any Anthropic-compatible key. Recommendations Service degrades to a
# rules-based fallback if this is unset (see backend/src/recommendations).
ANTHROPIC_API_KEY=

# --- Realtime / Social ---
REDIS_URL=redis://localhost:6379

# --- Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# --- Observability (Stage 3+) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
VITE_GOOGLE_MAPS_API_KEY=https://maps.googleapis.com/maps/api/js?key=AIzaSyAOVYRIgupAurZup5y1PRh8Ismb1A3lLao&libraries=places&callback=initMap

# Clerk (Google + Apple sign-in on /login)
# Get this from https://dashboard.clerk.com -> your app -> API Keys.
# Then, in the Clerk dashboard, go to "User & Authentication -> Social
# Connections" and enable Google and Apple.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YWxsb3dpbmctYnVjay04Ni5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_mytVuGC3mHkY0WJMIHiPhRPhmGGcwxzsRHyaUwPFiX

# --- Backend-only (do NOT prefix with VITE_ — never sent to the browser) ---
# Powers real Google Places data on the Discover/recommendations route
# (real names, photos, ratings, Google Maps links). See
# backend/README_RECOMMENDATIONS.md. This must be a DIFFERENT key from
# VITE_GOOGLE_MAPS_API_KEY above — restrict it by server IP, not referrer,
# and enable only the "Places API" (legacy) product on it.
GOOGLE_PLACES_API_KEY=https://maps.googleapis.com/maps/api/js?key=AIzaSyAOVYRIgupAurZup5y1PRh8Ismb1A3lLao&libraries=places&callback=initMap
